{
  "version": 2,
  "builds": [
    {
      "src": "quickserve/quickserve/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "quickserve/quickserve/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "quickserve.settings",
    "PYTHONPATH": "quickserve"
  }
}
