{
  "version": 2,
  "builds": [
    {
      "src": "quickserve/quickserve/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.11",
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)$",
      "dest": "/quickserve/pokemon/static/$1"
    },
    {
      "src": "/(.*)$",
      "dest": "/quickserve/quickserve/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "quickserve.settings",
    "PYTHONPATH": "$PYTHONPATH:quickserve"
  },
  "framework": null
}
